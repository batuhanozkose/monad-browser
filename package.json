{
  "name": "monad-browser",
  "version": "0.1.5",
  "description": "Headless, turnkey browser CLI for AI agents: compact AX snapshots with @refs, warm daemon, raw CDP. No Playwright.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhanozkose/monad-browser.git"
  },
  "homepage": "https://github.com/batuhanozkose/monad-browser#readme",
  "bugs": {
    "url": "https://github.com/batuhanozkose/monad-browser/issues"
  },
  "keywords": [
    "browser",
    "browser-automation",
    "cli",
    "ai-agents",
    "agents",
    "chrome",
    "chrome-devtools-protocol",
    "cdp",
    "headless",
    "mcp",
    "accessibility-tree",
    "snapshot"
  ],
  "author": "Batuhan Özköse",
  "bin": {
    "monad-browser": "dist/cli.js",
    "mb": "bin/mb"
  },
  "files": [
    "dist",
    "bin",
    "scripts/postinstall.mjs",
    "scripts/native-name.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/unit.test.mjs test/watch.test.mjs && node --test test/e2e.test.mjs test/watch-e2e.test.mjs",
    "test:shells": "node test/shell-e2e.mjs",
    "test:matrix": "node test/matrix.mjs",
    "build:native": "node scripts/build-native.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build && npm run build:native"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29"
  }
}
