{
  "name": "monad-browser",
  "version": "0.1.1",
  "description": "Headless, turnkey browser CLI for AI agents: compact AX snapshots with @refs, warm daemon, raw CDP. No Playwright.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhanozkose/monad-browser.git"
  },
  "homepage": "https://github.com/batuhanozkose/monad-browser#readme",
  "bugs": {
    "url": "https://github.com/batuhanozkose/monad-browser/issues"
  },
  "keywords": [
    "browser",
    "browser-automation",
    "cli",
    "ai-agents",
    "agents",
    "chrome",
    "chrome-devtools-protocol",
    "cdp",
    "headless",
    "mcp",
    "accessibility-tree",
    "snapshot"
  ],
  "author": "Batuhan Özköse",
  "bin": {
    "monad-browser": "dist/cli.js",
    "mb": "bin/mb"
  },
  "files": [
    "dist",
    "bin",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:native": "cd native && for t in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do CGO_ENABLED=0 GOOS=${t%/*} GOARCH=${t#*/} go build -trimpath -ldflags='-s -w' -o ../bin/native/mb-${t%/*}-${t#*/} . || exit 1; done",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build && npm run build:native"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29"
  }
}
